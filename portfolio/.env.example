# Database Configuration
# For local development, use a local PostgreSQL instance
# Example: postgresql://postgres:password@localhost:5432/portfolio_db
# For Supabase: postgresql://postgres.XXXXX:PASSWORD@db.XXXXX.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/portfolio"

# Node Environment
NODE_ENV="development"

# API Base URL (for frontend, optional - only needed if API is on different domain)
REACT_APP_API_URL="http://localhost:5173/api"
